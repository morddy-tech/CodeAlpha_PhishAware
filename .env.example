# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file.

# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production. Never run DEBUG=True in production.
DEBUG=True

# Serve static/media directly from the dev server. Defaults to DEBUG.
SERVE_STATIC_FILES=True
SERVE_MEDIA_FILES=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for HTTPS deployments, e.g.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-domain.com
CSRF_TRUSTED_ORIGINS=

# Database (optional). If left empty, SQLite is used for development.
# For PostgreSQL (production), provide a full URL:
#   DATABASE_URL=postgres://user:password@host:5432/phishaware
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Email (password reset etc.)
# Development default: console backend prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@phishaware.local

# Security
# Local development can keep these False. Production must use HTTPS and set
# USE_HTTPS=True plus SECURE_SSL_REDIRECT=True.
USE_HTTPS=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Only enable this behind a trusted proxy that overwrites X-Forwarded-* headers.
TRUST_PROXY_HEADERS=False

# Shared cache for rate limits. Required for multiple production workers.
REDIS_URL=

# Rate limiting
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOCKOUT_SECONDS=900
QUIZ_CLOCK_TOLERANCE_SECONDS=5

# Logging. Production containers should prefer stdout.
# LOG_TO_STDOUT=True

# Timezone
TIME_ZONE=UTC
