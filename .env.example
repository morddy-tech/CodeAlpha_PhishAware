# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file.

# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production. Never run DEBUG=True in production.
DEBUG=True

# Serve static/media directly from the dev server. Defaults to DEBUG, so this
# can be omitted in development. Keep it False in production and serve
# staticfiles/ from your web server instead.
SERVE_STATIC_FILES=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for HTTPS deployments, e.g.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-domain.com
CSRF_TRUSTED_ORIGINS=

# Database (optional). If left empty, SQLite is used for development.
# For PostgreSQL (production), provide a full URL:
#   DATABASE_URL=postgres://user:password@host:5432/phishaware
DATABASE_URL=

# Email (password reset etc.)
# Development default: console backend prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@phishaware.local

# Security (production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# Use a real secret key and DEBUG=False in production.

# Rate limiting
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOCKOUT_SECONDS=900

# Timezone
TIME_ZONE=UTC
